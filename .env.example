# ---- Core Mama Pilates — environment -------------------------------------
# Copy to .env.local. Never commit real values. Nothing here reaches the
# browser except the NEXT_PUBLIC_* keys.

# "demo" = sample availability + in-memory bookings (default).
# "live" = real GoHighLevel calendars and contacts via the server-side adapter.
GHL_MODE=demo

# GoHighLevel (LeadConnector) API v2 — Private Integration token.
GHL_API_KEY=
GHL_LOCATION_ID=

# One GHL calendar per booking type (see src/config/booking.ts).
GHL_CALENDAR_ID_REFORMER=
GHL_CALENDAR_ID_FIRST_VISIT=
GHL_CALENDAR_ID_TOUR=

# Founding member list automation.
GHL_FOUNDING_TAG=CoreMama-FoundingMember
GHL_FOUNDING_WORKFLOW_ID=

# Contact-form messages (GHL workflow) — optional.
GHL_CONTACT_WORKFLOW_ID=

# Public values.
NEXT_PUBLIC_SITE_URL=http://localhost:5330
NEXT_PUBLIC_STUDIO_TIMEZONE=America/Los_Angeles
